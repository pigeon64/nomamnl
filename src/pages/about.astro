---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
---
<Base title="About" description="Nomà gathers candles, scents and tableware from the houses we love most, authentic and wrapped by hand in Metro Manila.">
  <section class="container about section">
    <div class="about__media">
      <Img src="/images/site/story.webp" alt="Incense burning beside a green box on a stone table" sizes="(min-width: 768px) 50vw, 100vw" priority />
    </div>
    <div class="about__text">
      <p class="label">Nomà</p>
      <h1>Chosen slowly, delivered by hand.</h1>
      <p>We gather candles, scents and tableware from the houses we love most.</p>
      <p>Every piece is authentic, and every order leaves our hands wrapped with care.</p>
      <p>Made for long lunches, late baths and tables set for no particular reason.</p>
      <ul class="about__trust label">
        <li>Authentic, guaranteed</li>
        <li>Same-day Metro Manila</li>
        <li>GCash, card or COD</li>
      </ul>
      <a class="btn" href="/#collections">Shop the collections</a>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; align-items: center; gap: 40px; }
  .about__media { aspect-ratio: 4 / 5; background: var(--limestone); }
  .about__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .about__text p:not(.label) { margin-bottom: 0.6em; }
  .about__trust { list-style: none; margin: 32px 0; padding: 24px 0 0; border-top: 1px solid var(--gold); display: grid; gap: 8px; }
  @media (min-width: 768px) {
    .about { grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 120px); }
    .about__text { max-width: 480px; }
  }
</style>
