---
import InfoPage from '../components/InfoPage.astro';
import Icon from '../components/Icon.astro';
import { site, links } from '../config';
---
<InfoPage title="Contact" intro="The quickest way to reach us is a message. We'll reply as soon as we can."
  description={`Contact ${site.name}: message us on Messenger or Instagram, or email ${site.email}.`}>
  <ul class="contact">
    <li><a href={links.messenger} target="_blank" rel="noopener"><Icon name="messenger" size={18} /> Messenger</a></li>
    <li><a href={links.instagramDm} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a></li>
    <li><a href={links.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={18} /> Facebook</a></li>
    <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
  </ul>

  <h2>Orders</h2>
  <p>To order, tap <strong>Order on Messenger</strong> on any product; the message is written for you. See <a href="/how-to-order">how to order</a>.</p>

  <h2>Questions</h2>
  <p>Many answers are in the <a href="/faq">FAQ</a> and on <a href="/shipping-returns">shipping &amp; returns</a>.</p>
</InfoPage>
