---
// Photo tiles for the "browse by" pages (dinnerware brands and categories). Same look as /scents/brands.
// A tile's photo is optional: without one it's a plain forest block.
import Img from './Img.astro';
import Icon from './Icon.astro';
interface Tile { href: string; name: string; count: number; img?: string; alt: string }
interface Props { tiles: Tile[] }
const { tiles } = Astro.props;
---
<ul class="tiles">
  {tiles.map((t, i) => (
    <li class="reveal">
      <a class="tile zoom" href={t.href}>
        {t.img && <Img src={t.img} alt={t.alt} sizes="(min-width: 768px) 33vw, 100vw" priority={i === 0} />}
        <span class="tile__text">
          <span class="tile__name">{t.name}</span>
          <span class="tile__count label">{t.count} {t.count === 1 ? 'piece' : 'pieces'}</span>
          <span class="tile__cta label">Explore <Icon name="arrow" size={14} /></span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 768px) { .tiles { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .tile { position: relative; display: block; aspect-ratio: 4 / 5; color: var(--cream); text-decoration: none; background: var(--forest); }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tile:has(img)::after { content: ''; position: absolute; inset: 0; background: rgb(30 61 50 / 0.3); pointer-events: none; }
  .tile__text { position: absolute; left: clamp(20px, 3vw, 32px); right: clamp(20px, 3vw, 32px); bottom: clamp(20px, 3vw, 32px); z-index: 1; display: grid; gap: 6px; }
  .tile__name { font: 400 clamp(32px, 3vw, 40px)/1.05 var(--serif); text-wrap: balance; }
  .tile__count { font-size: 11px; opacity: 0.85; }
  .tile__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 11px; }
  .tile__cta :global(svg) { transition: transform 500ms var(--ease); }
  .tile:hover .tile__cta :global(svg) { transform: translateX(4px); }
  .tile { transition: transform 400ms var(--ease-out); }
  .tile:hover, .tile:focus-visible { transform: scale(1.04); z-index: 1; }
  .tile:focus-visible { outline-offset: 4px; }
</style>
