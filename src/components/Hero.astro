---
// Collection hero: photo by convention public/images/collections/<image>-hero.(webp|jpg|png), styled limestone block if missing.
// crumbs: [label, href] pairs above the title; the page itself is added as the last, unlinked crumb.
import Img from './Img.astro';
import { findImage } from '../lib/images';
interface Props { image: string; title: string; intro: string; crumbs?: [string, string][] }
const { image, title, intro, crumbs = [] } = Astro.props;
const heroFile = findImage(`/images/collections/${image}-hero`);
---
<header class="hero">
  {heroFile && <Img class="hero__img" src={heroFile} alt="" width={2400} height={1200} sizes="100vw" priority />}
  <div class="hero__text container">
    {crumbs.length > 0 && (
      <nav class="crumbs label" aria-label="Breadcrumb">
        {crumbs.map(([label, href]) => <><a href={href}>{label}</a> <span aria-hidden="true">/</span> </>)}
        <span aria-current="page">{title}</span>
      </nav>
    )}
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
</header>

<style>
  .hero {
    position: relative; display: grid; align-items: end; overflow: hidden;
    height: 45svh; min-height: 300px; margin-bottom: clamp(24px, 3vw, 40px);
    background: linear-gradient(135deg, var(--limestone), #d8cab1); color: var(--cream);
  }
  @media (min-width: 768px) { .hero { height: 60svh; min-height: 420px; max-height: 720px; } }
  .hero :global(.hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }  /* Soft dark gradient so cream type stays readable over any photo */
  .hero::after { content: ''; position: absolute; inset: 35% 0 0; background: linear-gradient(to top, rgb(20 34 28 / 0.7), rgb(20 34 28 / 0)); }
  .hero__text { position: relative; z-index: 1; padding-bottom: clamp(24px, 4vw, 56px); }
  .hero h1 { color: var(--cream); margin: 0 0 8px; font-size: clamp(44px, 6vw, 80px); }
  .hero p { margin: 0; max-width: 520px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; font-size: 11px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .crumbs [aria-current] { opacity: 0.85; }
  .crumbs a:focus-visible { outline-color: var(--cream); }
</style>
